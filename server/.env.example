# PIXELÉE MANAGER — Variables de entorno del backend (SOLO servidor)
# Copiar como .env. NUNCA exponer este archivo al frontend ni subirlo a GitHub.

# Puerto del API
PORT=4000

# Conexión a Postgres de Supabase — Session pooler IPv4 (puerto 6543)
# Supabase Dashboard → Project Settings → Database → Connection string → Session pooler
# OJO: el host directo db.<ref>.supabase.co es IPv6-only; en PCs sin IPv6 usar el pooler.
DATABASE_URL=

# Origen permitido del frontend
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (GoTrue). Publishable key = clave pública, segura en backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SOLO para `pnpm db:seed` si se quiere crear el usuario admin por código.
# NUNCA enviar al frontend. Si no se define, crear el usuario desde el dashboard
# de Supabase (Authentication → Add user → Auto Confirm).
SUPABASE_SERVICE_ROLE_KEY=

# Credenciales del administrador inicial para `pnpm db:seed` (opcional).
# NO se inventan: define aquí las que quieras usar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Permite auto-registro desde la pantalla de login (primer usuario = administrador).
ALLOW_SIGNUP=true
# Confirma el correo tras el registro (solo FASE 1 local sin SMTP).
# Equivale a «Auto Confirm» del dashboard. Poner false si se configura correo real.
AUTO_CONFIRM_SIGNUP=true

# Solo para pruebas de integración (NODE_ENV=test). Nunca en producción.
TEST_API_TOKEN=
