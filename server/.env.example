# PIXELEE Manager: plantilla de configuración del backend (solo servidor).
# Copiar a .env. No guardar valores reales en Git ni incluirlos en el frontend.

PORT=

# PostgreSQL administrado. Usa el connection string del Session pooler.
DATABASE_URL=

# Origen exacto del frontend publicado.
CORS_ORIGIN=
# Supabase Auth. La publishable key es pública por diseño; nunca usar aquí secret/service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Solo servidor / seed; jamás incluir en frontend ni repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: credenciales para pnpm db:seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Registro público y auto-confirmación apagados por defecto.
ALLOW_SIGNUP=
AUTO_CONFIRM_SIGNUP=

# Solo pruebas locales.
TEST_API_TOKEN=
